function useTypewriter(text, speed = 18, active = true) {
  const [displayed, setDisplayed] = useState("");
  const [done, setDone] = useState(false);
  useEffect(() => {
    if (!active) { setDisplayed(text); setDone(true); return; }
    setDisplayed(""); setDone(false);
    let i = 0;
    const id = setInterval(() => {
      i++;
      setDisplayed(text.slice(0, i));
      if (i >= text.length) { clearInterval(id); setDone(true); }
    }, speed);
    return () => clearInterval(id);
  }, [text, speed, active]);
  return { displayed, done };
}

function TypingBubble({ text, psych, onDone }) {
  const { displayed, done } = useTypewriter(text, 16, true);
  useEffect(() => { if (done && onDone) onDone(); }, [done, onDone]);
  return (
    <div style={{
      background: psych ? "rgba(99,102,241,0.22)" : "rgba(82,196,160,0.13)",
      border: `1px solid ${psych ? "rgba(129,140,248,0.35)" : "rgba(82,196,160,0.3)"}`,
      borderRadius: 16, padding: "12px 16px",
      maxWidth: "82%", fontSize: 13.5, lineHeight: 1.6,
      color: psych ? "#c7d2fe" : "#e2f5f0",
      alignSelf: "flex-start",
    }}>
      {displayed}{!done && <span style={{ opacity: 0.5 }}>▌</span>}
    </div>
  );
}

