function BioScanTerminal() {
  const videoRef = useRef(null);
  const [camActive, setCamActive] = useState(false);
  const [scanning, setScanning] = useState(false);
  const [scanStep, setScanStep] = useState(0);
  const [scanProgress, setScanProgress] = useState(0);
  const [showResults, setShowResults] = useState(false);
  const [camError, setCamError] = useState(false);

  const startCam = async () => {
    try {
      const stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: "user" } });
      if (videoRef.current) { videoRef.current.srcObject = stream; videoRef.current.play(); }
      setCamActive(true); setCamError(false);
    } catch {
      setCamError(true);
    }
  };

  const stopCam = () => {
    if (videoRef.current?.srcObject) {
      videoRef.current.srcObject.getTracks().forEach((t) => t.stop());
      videoRef.current.srcObject = null;
    }
    setCamActive(false); setScanning(false); setScanProgress(0); setScanStep(0);
  };

  const startScan = () => {
    setScanning(true); setScanProgress(0); setScanStep(0);
    const total = 15000;
    const stepDuration = total / SCAN_STEPS.length;
    let stepIndex = 0;
    const stepInterval = setInterval(() => {
      stepIndex++;
      if (stepIndex < SCAN_STEPS.length) setScanStep(stepIndex);
      else clearInterval(stepInterval);
    }, stepDuration);
    const progressInterval = setInterval(() => {
      setScanProgress((p) => {
        if (p >= 100) {
          clearInterval(progressInterval);
          setScanning(false);
          setShowResults(true);
          return 100;
        }
        return p + 100 / (total / 100);
      });
    }, 100);
  };

  return (
    <div style={{ display: "flex", flexDirection: "column", gap: 16 }}>
      {showResults && <DiagnosticCards onClose={() => setShowResults(false)} />}
      <div style={{
        position: "relative", background: "#000", borderRadius: 16,
        overflow: "hidden", aspectRatio: "16/9",
        border: `1px solid ${scanning ? MINT : "rgba(82,196,160,0.2)"}`,
        boxShadow: scanning ? `0 0 30px rgba(82,196,160,0.3)` : "none",
      }}>
        <video ref={videoRef} playsInline muted style={{
          width: "100%", height: "100%", objectFit: "cover",
          display: camActive ? "block" : "none",
        }} />
        {!camActive && (
          <div style={{
            position: "absolute", inset: 0, display: "flex",
            flexDirection: "column", alignItems: "center", justifyContent: "center",
            color: "#334155",
          }}>
            <div style={{ fontSize: 48, marginBottom: 12 }}>📷</div>
            <div style={{ fontSize: 14, color: "#475569" }}>
              {camError ? "Camera access denied. Please allow camera permissions." : "Camera inactive"}
            </div>
          </div>
        )}
        {camActive && scanning && (
          <>
            <div style={{
              position: "absolute", inset: 0, border: `2px solid ${MINT}`,
              borderRadius: 16, animation: "pulse-border 1.5s ease-in-out infinite", pointerEvents: "none",
            }} />
            {[0, 1, 2, 3].map((i) => (
              <div key={i} style={{
                position: "absolute",
                top: `${10 + i * 22}%`, left: "8%", right: "8%",
                height: 1, background: `rgba(82,196,160,${0.15 + i * 0.08})`,
                animation: `scan-line 2s ease-in-out ${i * 0.3}s infinite`,
              }} />
            ))}
            <div style={{
              position: "absolute", top: 12, left: 12, right: 12,
              background: "rgba(0,0,0,0.7)", borderRadius: 8,
              padding: "8px 12px",
            }}>
              <div style={{ color: MINT, fontSize: 11, marginBottom: 6 }}>
                🔬 {SCAN_STEPS[scanStep]}
              </div>
              <div style={{ height: 4, background: "rgba(255,255,255,0.1)", borderRadius: 4 }}>
                <div style={{
                  height: "100%", background: MINT,
                  width: `${scanProgress}%`, borderRadius: 4,
                  transition: "width 0.1s linear",
                }} />
              </div>
              <div style={{ color: "#64748b", fontSize: 10, marginTop: 4 }}>
                {Math.round(scanProgress)}% · Radial Artery + Torso Analysis
              </div>
            </div>
            <div style={{
              position: "absolute", bottom: 12, left: 12, right: 12,
              display: "flex", justifyContent: "center", gap: 16,
            }}>
              {["rPPG", "SpO₂", "RR", "BP"].map((m) => (
                <div key={m} style={{
                  background: "rgba(0,0,0,0.7)", border: "1px solid rgba(82,196,160,0.4)",
                  borderRadius: 6, padding: "4px 10px", color: MINT, fontSize: 11,
                }}>
                  <span style={{ display: "inline-block", width: 6, height: 6, borderRadius: "50%", background: MINT, marginRight: 5, animation: "pulse-dot 1s ease-in-out infinite" }} />
                  {m}
                </div>
              ))}
            </div>
          </>
        )}
        {camActive && !scanning && (
          <div style={{
            position: "absolute", top: 12, left: 12,
            background: "rgba(0,0,0,0.6)", border: "1px solid rgba(82,196,160,0.4)",
            borderRadius: 6, padding: "4px 10px", color: MINT, fontSize: 11,
          }}>
            <span style={{ display: "inline-block", width: 6, height: 6, borderRadius: "50%", background: "#22c55e", marginRight: 5 }} />
            Camera Live
          </div>
        )}
      </div>
      <div style={{ display: "flex", gap: 10 }}>
        {!camActive ? (
          <button onClick={startCam} style={btnStyle(MINT, "rgba(82,196,160,0.15)")}>
            📷 Activate Webcam
          </button>
        ) : (
          <>
            <button onClick={startScan} disabled={scanning} style={btnStyle(MINT, "rgba(82,196,160,0.15)", scanning)}>
              {scanning ? "⟳ Scanning..." : "🔬 Initiate Radial Artery / Torso Scan"}
            </button>
            <button onClick={stopCam} style={btnStyle("#f87171", "rgba(239,68,68,0.1)")}>
              ✕ Stop
            </button>
          </>
        )}
      </div>
      <style>{`
        @keyframes pulse-border { 0%,100%{opacity:1} 50%{opacity:0.3} }
        @keyframes scan-line { 0%{opacity:0.2} 50%{opacity:0.8} 100%{opacity:0.2} }
        @keyframes pulse-dot { 0%,100%{opacity:1} 50%{opacity:0.3} }
      `}</style>
    </div>
  );
}

function btnStyle(color, bg, disabled = false) {
  return {
    background: bg, border: `1px solid ${color}55`,
    color, borderRadius: 10, padding: "10px 18px",
    cursor: disabled ? "not-allowed" : "pointer",
    fontSize: 13, opacity: disabled ? 0.6 : 1,
    fontWeight: 600, display: "flex", alignItems: "center", gap: 6,
    transition: "all 0.2s",
  };
}

